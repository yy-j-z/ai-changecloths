{
  "name": "ai-fitting-mirror",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "build:web": "npm run build --workspace frontend",
    "lint:web": "npm run lint --workspace frontend",
    "test:web": "npm run test --workspace frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:web": "npm run lint:web && npm run test:web && npm run build:web",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "prettier": "3.6.2"
  }
}

